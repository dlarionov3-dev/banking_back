<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.dlarionov3-dev</groupId>
    <artifactId>banking-bom</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Banking Project BOM</name>
    <description>Centralized dependency management for Banking Project</description>

    <distributionManagement>
        <repository>
            <id>bankingBack</id>
            <url>https://maven.pkg.github.com/dlarionov3-dev/banking_back</url>
        </repository>
    </distributionManagement>

    <scm>
        <connection>scm:git:git://github.com/dlarionov3-dev/banking_back.git</connection>
        <developerConnection>scm:git:ssh://github.com:dlarionov3-dev/banking_back.git</developerConnection>
        <url>https://github.com/dlarionov3-dev/banking_back</url>
    </scm>

    <properties>
        <project.version>1.0-SNAPSHOT</project.version>
        <jrpc-server.version>3.1.0.RELEASE</jrpc-server.version>
        <openapi-starter.version>2.8.5</openapi-starter.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.46</lombok.version>
        <junit.version>4.12</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.dlarionov3-dev</groupId>
                <artifactId>banking-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.dlarionov3-dev</groupId>
                <artifactId>banking-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.dlarionov3-dev</groupId>
                <artifactId>banking-command</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.dlarionov3-dev</groupId>
                <artifactId>banking-query</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.dlarionov3-dev</groupId>
                <artifactId>banking-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${openapi-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>net.devh</groupId>
                <artifactId>grpc-server-spring-boot-starter</artifactId>
                <version>${jrpc-server.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>